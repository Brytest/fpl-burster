{
  "name": "fpl-burster",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Fantasy Premier League bot — 9 independent jobs (deadline alerts, price changes, live points, standings, and 5 weekly content posts), each run on its own GitHub Actions schedule. No single entry point by design.",
  "scripts": {
    "deadline-alerts": "node jobs/deadlineAlerts.js",
    "price-changes": "node jobs/priceChanges.js",
    "live-points": "node jobs/livePoints.js",
    "league-standings": "node jobs/leagueStandings.js",
    "weekly-recap": "node jobs/weeklyRecap.js",
    "transfer-trends": "node jobs/transferTrends.js",
    "hidden-gems": "node jobs/hiddenGems.js",
    "fixture-focus": "node jobs/fixtureFocus.js",
    "deadline-tips": "node jobs/deadlineTips.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
